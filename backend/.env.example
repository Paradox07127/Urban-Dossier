# Urban Dossier backend — environment template.
# Copy to `.env` (or export in your shell) before launching uvicorn.

# --- Data layer ---------------------------------------------------------
URBAN_DOSSIER_DATA_MODE=direct
URBAN_DOSSIER_RAW_DATA_ROOT=~/nyc_open_data
# URBAN_DOSSIER_READY_ROOT=  # auto-detected; set to override

# --- LLM (vLLM serving Nemotron 30B NVFP4) ------------------------------
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-needed
URBAN_DOSSIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
URBAN_DOSSIER_USE_LLM=auto
URBAN_DOSSIER_LLM_TIMEOUT=8

# --- NemoClaw / agent ---------------------------------------------------
URBAN_DOSSIER_AGENT_BACKEND=nemoclaw
URBAN_DOSSIER_AGENT_ENABLED=1
NEMOCLAW_BIN=nemoclaw
NEMOCLAW_SANDBOX=urban-dossier-agent
OPENCLAW_TRANSPORT=gateway
OPENCLAW_AGENT_ID=urban-dossier
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN_FILE=/mnt/data/urban-dossier-state/runtime/openclaw-gateway.token

# --- GPU acceleration ---------------------------------------------------
# Local development defaults to the portable CPU reference path. The x86
# production vLLM GPU runs in Docker and does not require backend CUDA imports.
URBAN_DOSSIER_GPU_DETECT=0
URBAN_DOSSIER_GPU_ACCEL=0

# --- Demo / security ----------------------------------------------------
# Set DEMO_TOKEN to any non-empty value to require X-Urban-Dossier-Token header
# on every API request (except /api/health and /api/agent/status).
URBAN_DOSSIER_DEMO_TOKEN=

# --- Optional RAG (vLLM embeddings; not on the dedicated-agent path) ----
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_KEY=not-needed
EMBEDDING_DIM=2560
RERANKER_DEVICE=cpu
RAG_PREFER_GPU=0
