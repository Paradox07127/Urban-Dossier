# Validated x86 workstation backend configuration (2026-08-02).
# Copy to /mnt/data/urban-dossier/runtime/backend.env.
# This file contains no secret values; the Gateway token stays in a mode-0600
# file referenced by OPENCLAW_GATEWAY_TOKEN_FILE.

# Data layer: deterministic DuckDB/Parquet execution on the host.
URBAN_DOSSIER_DATA_MODE=direct
URBAN_DOSSIER_RAW_DATA_ROOT=/mnt/data/urban-dossier/datasets/raw
URBAN_DOSSIER_READY_ROOT=/mnt/data/Urban-Dossier/data/ready
BLOCKSENSE_SKILL_PATH=/mnt/data/Urban-Dossier/skills

# Local vLLM/Nemotron endpoint.
URBAN_DOSSIER_USE_LLM=1
URBAN_DOSSIER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=not-needed

# Dedicated NemoClaw/OpenClaw agent.
URBAN_DOSSIER_AGENT_ENABLED=1
URBAN_DOSSIER_AGENT_BACKEND=nemoclaw
NEMOCLAW_BIN=/home/taijial/.local/bin/nemoclaw
NEMOCLAW_SANDBOX=urban-dossier-agent
OPENCLAW_TRANSPORT=gateway
OPENCLAW_AGENT_ID=urban-dossier
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN_FILE=/mnt/data/urban-dossier/runtime/openclaw-gateway.token

# The production backend currently uses CPU DuckDB/Parquet. GPU inference stays
# isolated in Docker; enable backend CUDA adapters only after separate tests.
URBAN_DOSSIER_GPU_DETECT=0
URBAN_DOSSIER_GPU_ACCEL=0

# Optional RAG service. It is not on the current dedicated-agent critical path.
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_API_KEY=not-needed
EMBEDDING_DIM=2560
RERANKER_DEVICE=cpu
RAG_PREFER_GPU=0

# Empty means no demo-token middleware. Set a value only together with the
# matching frontend X-Urban-Dossier-Token configuration.
URBAN_DOSSIER_DEMO_TOKEN=
