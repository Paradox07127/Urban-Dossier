# Persistent state belongs on the workstation's second SSD.
URBAN_DOSSIER_STATE_ROOT=/mnt/data/urban-dossier-state

# The workstation benchmarked profile reserves 45% for the NVFP4 LLM and 15%
# for embeddings.  At 45%, the LLM still has about 1.3M tokens of FP8 KV cache
# while leaving ample VRAM for embeddings, cuVS, reranking, and experiments.
LLM_PORT=8000
LLM_GPU_MEMORY_UTILIZATION=0.45
LLM_MAX_MODEL_LEN=32768
LLM_MAX_NUM_SEQS=8
LLM_MAX_BATCHED_TOKENS=32768
LLM_KV_CACHE_DTYPE=fp8
LLM_SERVED_NAME=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
# vLLM 0.23 equivalent of the validated legacy FlashInfer throughput backend.
LLM_MOE_BACKEND=flashinfer_cutlass

EMBEDDING_PORT=8001
EMBEDDING_GPU_MEMORY_UTILIZATION=0.15
EMBEDDING_SERVED_NAME=Qwen/Qwen3-Embedding-4B

# --- Candidate models (side-by-side evaluation, see MODEL_CANDIDATES.md) ---
# Nemotron 3.5 Lightning 30B-A3B NVFP4 + DSpark drafter, port 8002.
# 0.30 lets it run next to the production llm (0.45) during A/B benchmarks.
LIGHTNING_PORT=8002
LIGHTNING_GPU_MEMORY_UTILIZATION=0.30
LIGHTNING_MAX_MODEL_LEN=32768
LIGHTNING_MAX_NUM_SEQS=8
LIGHTNING_MAX_BATCHED_TOKENS=32768
LIGHTNING_SERVED_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
LIGHTNING_MOE_BACKEND=marlin

# Nemotron 3 Super 120B-A12B NVFP4, port 8003.  80.3 GiB of weights: stop all
# other GPU services before starting, and expect tight KV-cache headroom.
SUPER_PORT=8003
SUPER_GPU_MEMORY_UTILIZATION=0.92
SUPER_MAX_MODEL_LEN=32768
SUPER_MAX_NUM_SEQS=2
SUPER_SERVED_NAME=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
SUPER_MOE_BACKEND=marlin
