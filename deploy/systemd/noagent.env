# Overrides for ud-backend-noagent.service, listed AFTER backend.env.
#
# This has to be an EnvironmentFile rather than an Environment= line in the
# unit: systemd applies EnvironmentFile= settings on top of Environment=
# regardless of the order they appear in the unit, so an Environment= override
# of a variable that backend.env also sets is silently ignored.  Later
# EnvironmentFile= entries do win over earlier ones, which is what this is.
URBAN_DOSSIER_AGENT_ENABLED=0
