[Unit]
Description=Urban Dossier frontend and tile server (3456)
After=network-online.target ud-backend-noagent.service
Wants=network-online.target
PartOf=ud-stack.target

[Service]
Type=simple
WorkingDirectory=/mnt/data/Urban-Dossier
Environment=URBAN_DOSSIER_PORT=3456
Environment=URBAN_DOSSIER_BACKEND_URL=http://127.0.0.1:8090
# Not /usr/bin/node: see the script.  better-sqlite3 is a native addon and
# only loads under the Node ABI it was built against.
ExecStart=/mnt/data/Urban-Dossier/scripts/run_frontend.sh
Restart=on-failure
RestartSec=3s
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=ud-stack.target
