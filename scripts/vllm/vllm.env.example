# vllm.env.example — copy to vllm.env and edit. start_vllm.sh auto-sources it.
#
# All values shown are the start_vllm.sh defaults — uncomment + override only
# what you need. Lines beginning with `#` are comments.

# -------- Profile --------
# Which preset to launch. CLI flag --profile wins over this env var.
#   demo          ctx=8192    seqs=16   (Hack Fair / multi-judge concurrent)
#   balanced      ctx=32768   seqs=8    (daily use — DEFAULT)
#   long-context  ctx=131072  seqs=1    (single long-document analysis)
# PROFILE=balanced

# -------- Model location --------
# Path or HF id. The Urban Dossier deploy notes assume the weights are
# bind-mounted at /model. Override if you keep them elsewhere.
# MODEL_PATH=/model

# Name advertised on GET /v1/models. Backend code matches against
# `nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4`, so don't change unless you
# also update URBAN_DOSSIER_MODEL.
# SERVED_NAME=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4

# Path to the reasoning parser plugin shipped in the model repo.
# Defaults to $MODEL_PATH/nano_v3_reasoning_parser.py. Download once with:
#   wget -O /model/nano_v3_reasoning_parser.py \
#     https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4/resolve/main/nano_v3_reasoning_parser.py
# PARSER_PLUGIN=/model/nano_v3_reasoning_parser.py

# -------- Network --------
# HOST=0.0.0.0
# PORT=8000

# -------- FlashInfer FP4 MoE backend --------
# These are pre-set by start_vllm.sh. Override only if vLLM upstream changes
# the env-var names or you want to A/B with the 'latency' backend.
# VLLM_USE_FLASHINFER_MOE_FP4=1
# VLLM_FLASHINFER_MOE_BACKEND=throughput   # alternatives: latency

# -------- Optional: SM 12.1 kernel workaround --------
# If you hit "cutlass_moe_mm" related crashes on GB10, uncomment. See
# docs/nvidia-stack-dgx-spark.md and the dgx-vllm NVFP4_BREAKTHROUGH notes.
# VLLM_DISABLED_KERNELS=cutlass_moe_mm,cutlass_scaled_mm

# -------- Escape hatch --------
# Anything in EXTRA_ARGS is appended verbatim to the vllm CLI. Useful for
# quick experiments without editing the script. Quote the whole string.
# EXTRA_ARGS="--logits-processors my.module:MyProcessor --disable-log-stats"
